#include <stdio.h>
#include <stdlib.h>

int main(int argc, char *argv[]) {
    
    char letra;
    
    printf("Insira uma letra:\n");
    scanf("%c", &letra);

    switch (letra) {
        case 'a':
            printf("a de AMOR");
            break;

        case 'b':
            printf("b de BAIXINHO");
            break;

        case 'c':
            printf("c de CORAÇÃO");
            break;

        case 'd':
            printf("d de DOCINHO");
            break;
    }

    return 0;
}
